# FRED API Key (Get yours at: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///data/processed/liquidity_flow.db

# Dashboard Configuration
DASHBOARD_PORT=8501
DASHBOARD_HOST=localhost

# Data Update Schedule (cron format for GitHub Actions)
# Default: Daily at 01:00 UTC
DATA_UPDATE_CRON=0 1 * * *

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
